<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name='viewport' content='width=device-width, initial-scale=1, user-scalable=0'>
    <meta name='apple-mobile-web-app-capable' content='yes' />
    <meta name='apple-mobile-web-app-status-bar-style' content='black' />
    <meta name="google" content="notranslate">
    <title>@(ViewBag.Title ?? "Avid5")</title>

    @Html.Raw(Render.Stylesheet("Site"))
    <link rel="stylesheet" href="~/css/nouislider.fox.css" />

    @* Dynamically switch manifest *@
    <link rel="manifest" href="@(ViewBag.ManifestUrl ?? "/manifest.json")" />

    @* Standard desktop favicon *@
    <link rel="shortcut icon" href="~/favicon.ico" />

    @* Dynamic mobile & touch icons (falls back to root defaults) *@
    <link rel="apple-touch-icon" href="@(ViewBag.IconUrl ?? "/icons/main-192.png")" />
    <link rel="icon" type="image/png" sizes="192x192" href="@(ViewBag.IconUrl ?? "/icons/main-192.png")" />

    @Html.Raw(Button.FontReference)
</head>
<body>
    @RenderBody()

    <script src='~/lib/jquery/dist/jquery.min.js' type='text/javascript'></script>
    <script src='~/js/modernizr-2.8.3.js' type='text/javascript'></script>
    <script src='~/js/touch-emulator.js' type='text/javascript'></script>
    <script src='~/js/jquery.nouislider.js' type='text/javascript'></script>
    <script src='~/js/jquery.easing.min.js' type='text/javascript'></script>
    <script src='~/js/hammer.js' type='text/javascript'></script>
    @Html.Raw(Render.Script("functions"))
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
